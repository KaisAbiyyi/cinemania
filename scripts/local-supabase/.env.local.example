# ==============================================================================
# CineMatch Local Supabase Infrastructure — Synthetic Environment Reference
# ==============================================================================
# DO NOT put real or hosted credentials here.
# Generate fresh disposable local secrets with:
#   node scripts/local-supabase/generate-env.cjs
#   node scripts/local-supabase/generate-env.cjs --app-env
#
# Stack secrets live in gitignored: supabase/.env.local
# Next.js loopback app vars live in gitignored: supabase/.env.app.local
# ==============================================================================

# --- Loopback-only Docker Supabase Stack (supabase/.env.local) ---
# POSTGRES_PASSWORD=<generated-random-hex>
# JWT_SECRET=<generated-random-hex>
# SECRET_KEY_BASE=<generated-random-hex>
# ANON_KEY=<generated-hs256-anon-jwt>
# SERVICE_ROLE_KEY=<generated-hs256-service-role-jwt>

# --- Local Next.js App Loopback Configuration (supabase/.env.app.local) ---
# Requires NODE_ENV=development or NODE_ENV=test AND CINEMATCH_ALLOW_LOCAL_REALTIME=true
# (PR #51 HEAD d82fa162 loopback guard in src/lib/server/realtime/supabasePublisher.ts)
DATABASE_URL=postgresql://supabase_admin:<POSTGRES_PASSWORD>@127.0.0.1:55432/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<SERVICE_ROLE_KEY>
SUPABASE_JWT_SECRET=<JWT_SECRET>
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY>
CINEMATCH_ALLOW_LOCAL_REALTIME=true
CINEMATCH_CAPABILITY_SECRET=<generated-random-hex>
TMDB_API_RAT=synthetic-local-tmdb-rat
IPINFO_TOKEN=synthetic-local-ipinfo-token
YOUTUBE_API_KEY=synthetic-local-youtube-key
NEXT_PUBLIC_TMDB_POSTER_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_IMAGE_BASE_URL=https://image.tmdb.org/t/p
