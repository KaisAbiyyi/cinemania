# ==============================================================================
# CineMatch Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit .env or .env.local with real secrets to version control.
# - TMDB_API_RAT is a server-only Bearer token. It must NEVER be prefixed with NEXT_PUBLIC_.
# - For offline development without live TMDB credentials, refer to Section 5 of README.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TMDB (The Movie Database) API Configuration [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Upstream: https://developer.themoviedb.org/docs/getting-started
# Scope: Server-side API routes and services (src/services/tmdbApi.ts)
# Format: v4 Read Access Token (Bearer JWT)
# Behavior when omitted: Upstream TMDB returns 401 Unauthorized.
# Offline fallback: Use synthetic mock fixtures (docs/artifacts/cine-002/fixtures/mock_tmdb.cjs).
TMDB_API_RAT=your_tmdb_v4_read_access_token_here

# ------------------------------------------------------------------------------
# 2. Google YouTube Data API v3 [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Upstream: https://developers.google.com/youtube/v3/getting-started
# Scope: Server-side trailer proxy (src/app/api/youtube/route.ts)
# Format: Google Cloud API Key
# Behavior when omitted: Returns HTTP 500 {"error": "Server configuration error"}.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ------------------------------------------------------------------------------
# 3. IPInfo Geolocation API [SERVER-ONLY]
# ------------------------------------------------------------------------------
# Upstream: https://ipinfo.io
# Scope: Server-side region detection (src/app/api/geolocation/route.ts)
# Behavior when omitted: Localhost requests (127.0.0.1 / ::1) automatically return
# {"region": "US"}. For external IPs, omitting this token returns HTTP 500 fallback.
IPINFO_TOKEN=your_ipinfo_token_here

# ------------------------------------------------------------------------------
# 4. TMDB Poster & Asset Base URLs [PUBLIC / CLIENT-SIDE]
# ------------------------------------------------------------------------------
# Scope: Browser rendering of movie/TV posters, backdrops, and avatars
# Upstream default: https://image.tmdb.org/t/p
# Format: Fully qualified HTTPS URL without trailing slash
NEXT_PUBLIC_TMDB_POSTER_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_IMAGE_BASE_URL=https://image.tmdb.org/t/p
